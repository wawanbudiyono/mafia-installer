[Unit]
Description=Google Drive Mount
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount gdrive: /mnt/storage/data/GoogleDrive \
    --allow-other \
    --vfs-cache-mode full \
    --dir-cache-time 72h \
    --poll-interval 15s \
    --buffer-size 64M \
    --vfs-read-ahead 128M \
    --vfs-cache-max-age 24h \
    --fast-list
ExecStop=/bin/fusermount -uz /mnt/storage/data/GoogleDrive
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target